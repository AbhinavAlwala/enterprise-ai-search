# The application reads process environment variables, not this file.
# Docker Compose explicitly forwards these three variables from the shell or .env.
# Set the full non-streaming chat-completions URL and a model served by that endpoint.
# Host CLI/API example: http://localhost:11434/v1/chat/completions
# Docker Desktop example: http://host.docker.internal:11434/v1/chat/completions
GENERATION_ENDPOINT=
GENERATION_MODEL=
# Optional; leave empty for endpoints that do not require authentication.
GENERATION_API_KEY=
# Required for the HTTP API; missing or invalid policy configuration fails closed.
# Host demo: config/demo_access.json. Compose sets its mounted container path explicitly.
AUTHORIZATION_POLICY_PATH=
# Explicitly blank endpoint/model values disable generation; Compose defaults apply
# only when they are unset. Unix bind-mount owners can set CONTAINER_UID/GID in the shell.
